# Optional for local dev, REQUIRED for a working production deploy on Vercel.
#
# Vercel serverless functions don't share memory across instances, so without
# Redis the in-memory fallback store won't stay consistent once real traffic
# hits more than one instance (rooms may "disappear" or votes get inconsistent).
#
# Get free credentials in seconds:
#   1. Vercel dashboard → your project → Storage → Marketplace Database Providers → Upstash → Redis (or upstash.com directly)
#   2. Copy the REST URL and REST TOKEN it gives you into the values below
#      (Vercel's own integration sets these env vars for you automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
